{
  "manifest_version": 3,
  "name": "Learn Vocab Tab",
  "version": "0.1.0",
  "description": "Un mot de vocabulaire illustré à chaque ouverture — pensé pour Arc.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Learn Vocab Tab",
    "default_popup": "html/popup.html"
  },
  "commands": {
    "open-vocab-tab": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Ouvrir la page de vocabulaire"
    }
  },
  "chrome_url_overrides": {
    "newtab": "html/tab.html"
  }
}
